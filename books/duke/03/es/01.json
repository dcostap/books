      "line": [
        {"t": [0, 1, 2, 3, 4, 5], "es": "«Pero me gustaría quedarme"},
        {"t": [6, 7, 8, 9], "es": "cerca del misterio,"},
        {"t": [10, 11, 12, 13], "es": "aquí, en el colegio."}
