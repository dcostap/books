        {"t": [2], "es": "y"},
        {"t": [3], "es": "señor", "note": "*Mr* va delante del apellido o del nombre completo. En inglés británico suele ir sin punto; en EE. UU., *Mr.* ([[british-american]])."},
        {"t": [4], "es": "Wilder"},
        {"t": [5, 6], "es": "su secretario", "base": "secretary", "sense": "assistant"},
        {"t": [7], "es": "están", "base": "be", "sense": "state"},
        {"t": [8, 9, 10], "es": "en mi despacho", "base": "office", "sense": "room"}
