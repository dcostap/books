        {"t": [10], "es": "señor", "note": "*Mr* va delante del apellido o del nombre completo. En inglés británico suele ir sin punto; en EE. UU., *Mr.* ([[british-american]])."},
        {"t": [11], "es": "Holmes"}
      ]
    },
    {
