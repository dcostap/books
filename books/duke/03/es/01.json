        {"t": [2, 3, 4], "es": "ya está aquí,"},
        {"t": [5, 6, 7, 8, 9, 10], "es": "y quizá pueda ayudarnos»."}
      ],
      "words": [
        {"t": [0], "es": "señor", "note": "*Mr* va delante del apellido o del nombre completo. En inglés británico suele ir sin punto; en EE. UU., *Mr.* ([[british-american]])."},
        {"t": [1], "es": "Holmes"},
        {"t": [2], "es": "está", "base": "be", "sense": "state"},
        {"t": [3], "es": "aquí", "base": "here", "sense": "place"},
        {"t": [4], "es": "ahora", "base": "now", "sense": "present"},
        {"t": [5], "es": "y"},
