      ]
    },
    {
      "id": 68,
      "line": [
        {"t": [0, 1, 2], "es": "«Es posible"},
        {"t": [3, 4, 5, 6, 7, 8, 9], "es": "cruzar el páramo en bicicleta:"},
        {"t": [11, 12, 13], "es": "difícil, pero posible»."}
      ],
      "words": [
        {"t": [0], "es": "(no se traduce)", "note": "*It* no se refiere a ninguna cosa: ocupa el lugar del sujeto. La idea viene después, en *to ride…* ([[dummy-subject]])."},
        {"t": [1], "es": "es", "base": "be", "sense": "identity"},
        {"t": [2], "es": "posible", "base": "possible", "sense": "able"},
        {"t": [3, 4], "es": "montar", "base": "ride", "sense": "mount", "note": "*Ride a bicycle* es ir en bicicleta. *Ride* se usa con bicicletas, motos y caballos, pero no para conducir un coche."},
        {"t": [5, 6], "es": "una bicicleta", "base": "bicycle", "sense": "vehicle"},
        {"t": [7, 8, 9], "es": "a través del páramo", "base": "moor", "sense": "land"},
        {"t": [11], "es": "difícil", "base": "difficult", "sense": "hard"},
        {"t": [12], "es": "pero"},
        {"t": [13], "es": "posible", "base": "possible", "sense": "able"}
      ]
    },
    {
      "id": 69,
      "line": [
        {"t": [0, 1], "es": "Justo entonces"},
        {"t": [2, 3, 4, 5], "es": "el doctor Huxtable entró deprisa"},
        {"t": [6, 7, 8], "es": "en la habitación."}
      ],
      "words": [
        {"t": [0], "es": "justo", "base": "just", "sense": "exactly"},
        {"t": [1], "es": "entonces", "base": "then", "sense": "time"},
        {"t": [2], "es": "doctor", "note": "Abreviatura de *doctor*. En inglés británico suele ir sin punto; en EE. UU., *Dr.* ([[british-american]])."},
        {"t": [3], "es": "Huxtable"},
        {"t": [4], "es": "vino", "base": "come", "sense": "move", "note": "Con *into the room*, indica que vino al interior de la habitación. En la frase española decimos «entró»."},
        {"t": [5], "es": "deprisa", "base": "quickly", "sense": "speed"},
        {"t": [6, 7, 8], "es": "a la habitación", "base": "room", "sense": "building", "note": "*Into* indica movimiento hacia dentro; *in* indica dónde está algo."}
      ]
    },
    {
      "id": 70,
      "line": [
        {"t": [0, 1, 2], "es": "«¡Noticias, señor Holmes!»,"},
        {"t": [3, 4, 5], "es": "dijo entusiasmado."}
      ],
      "words": [
        {"t": [0], "es": "noticias", "base": "news", "sense": "information", "note": "Aunque acaba en *-s*, *news* no es plural: es un sustantivo incontable ([[uncountable]])."},
        {"t": [1], "es": "señor", "note": "*Mr* va delante del apellido o del nombre completo. En inglés británico suele ir sin punto; en EE. UU., *Mr.* ([[british-american]])."},
        {"t": [2], "es": "Holmes"},
        {"t": [3], "es": "él"},
        {"t": [4], "es": "dijo", "base": "say", "sense": "speak"},
        {"t": [5], "es": "con entusiasmo", "base": "excitedly", "sense": "emotion", "note": "Ojo: no es «excitado», que en español suele tener sentido sexual. Indica entusiasmo o emoción ([[false-friends]])."}
      ]
    },
    {
      "id": 71,
      "line": [{"t": [0, 1, 2], "es": "«¡Traigo noticias!»."}],
      "words": [
        {"t": [0], "es": "yo"},
