        {"t": [3], "es": "es", "base": "be", "sense": "identity"},
        {"t": [4, 5], "es": "del niño", "base": "boy", "sense": "child", "note": "El *’s* indica de quién es algo: *the boy’s hat* = «la gorra del niño» ([[possessive-s]])."},
        {"t": [6], "es": "gorra", "base": "hat", "sense": "headwear"}
      ]
    },
    {
      "id": 74,
      "line": [
        {"t": [0, 1, 2, 3], "es": "Uno de mis jardineros"},
        {"t": [4, 5], "es": "la encontró"},
        {"t": [6, 7], "es": "esta tarde»."}
      ],
      "words": [
        {"t": [0], "es": "uno"},
