        {"t": [4], "es": "encontró", "base": "find", "sense": "discover"},
        {"t": [5], "es": "la", "note": "*It* se refiere a una cosa, sin distinguir masculino y femenino. Aquí sustituye a *hat*, «gorra»."},
        {"t": [6, 7], "es": "esta tarde", "base": "evening", "sense": "time", "note": "*Evening* es el final de la tarde y el principio de la noche, no la tarde entera, que es *afternoon*."}
      ]
