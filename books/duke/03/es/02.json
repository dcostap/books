      "words": [
        {"t": [0], "es": "cuándo", "base": "when", "sense": "question"},
        {"t": [1, 3], "es": "envió por correo", "base": "post", "sense": "send", "note": "Uso británico; en EE. UU., *mail* ([[british-american]]). *Did* marca la pregunta en pasado; *post* no cambia ([[auxiliary-do]])."},
        {"t": [2], "es": "usted"},
        {"t": [4], "es": "la, esa carta"}
      ]
    },
    {
      "id": 31,
      "line": [
        {"t": [0, 1], "es": "«¿Enviarla por correo?»,"},
        {"t": [2, 3, 4], "es": "dijo el señor Wilder"},
        {"t": [5], "es": "enfadado."}
      ],
      "words": [
        {"t": [0], "es": "enviar por correo", "base": "post", "sense": "send", "note": "Uso británico; en EE. UU., *mail* ([[british-american]])."},
        {"t": [1], "es": "la, esa carta"},
        {"t": [2], "es": "dijo", "base": "say", "sense": "speak"},
        {"t": [3], "es": "señor", "note": "*Mr* va delante del apellido o del nombre completo. En inglés británico suele ir sin punto; en EE. UU., *Mr.* ([[british-american]])."},
        {"t": [4], "es": "Wilder"},
        {"t": [5], "es": "con enfado", "base": "angrily", "sense": "anger"}
      ]
    },
    {
      "id": 32,
      "line": [
        {"t": [0, 1], "es": "«El duque"},
