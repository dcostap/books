{
  "sentences": [
    {
      "id": 27,
      "line": [
        {"t": [0, 1], "es": "«La duquesa"},
        {"t": [2, 3, 4, 5], "es": "no sabe nada de esto»,"},
        {"t": [6, 7, 8], "es": "dijo el duque,"},
        {"t": [9, 10, 11, 12, 13, 14, 15], "es": "«y nadie me está pidiendo dinero»."}
      ],
      "words": [
        {"t": [0, 1], "es": "la duquesa", "base": "duchess", "sense": "title"},
        {"t": [2, 4], "es": "sabe de", "base": "know", "sense": "information", "note": "*Know about* es tener información sobre algo, no conocer personalmente a alguien."},
        {"t": [3], "es": "nada", "note": "*Nothing* ya niega la frase: no se añade *not*, aunque en español digamos «no sabe nada» ([[negative-words]])."},
        {"t": [5], "es": "esto"},
        {"t": [6], "es": "dijo", "base": "say", "sense": "speak"},
        {"t": [7, 8], "es": "el duque", "base": "duke", "sense": "noble"},
        {"t": [9], "es": "y"},
        {"t": [10], "es": "nadie"},
        {"t": [11, 12, 14], "es": "está pidiendo", "base": "ask for", "sense": "request", "note": "*Ask for* es pedir algo; *ask* sin *for* suele ser preguntar. *Is asking* indica una acción en curso ([[present-continuous]])."},
        {"t": [13], "es": "me, a mí"},
        {"t": [15], "es": "dinero", "base": "money", "sense": "payment"}
      ]
    },
    {
      "id": 28,
      "line": [
        {"t": [0, 1], "es": "«Entiendo»,"},
        {"t": [2, 3], "es": "dijo Holmes."}
      ],
      "words": [
        {"t": [0], "es": "yo"},
        {"t": [1], "es": "entiendo", "base": "see", "sense": "understand", "note": "*I see* sirve para decir que has entendido algo; no se refiere a la vista."},
        {"t": [2], "es": "dijo", "base": "say", "sense": "speak"},
        {"t": [3], "es": "Holmes"}
      ]
    },
    {
      "id": 29,
      "line": [
        {"t": [0, 1, 2, 3], "es": "«Usted escribió una carta"},
        {"t": [4, 5, 6], "es": "a su hijo"},
        {"t": [7, 8, 9], "es": "antes de que desapareciera."}
      ],
      "words": [
        {"t": [0], "es": "usted"},
        {"t": [1], "es": "escribió", "base": "write", "sense": "text"},
        {"t": [2, 3], "es": "una carta", "base": "letter", "sense": "message", "note": "Ojo: *letter* es «carta», y también «letra» del alfabeto ([[false-friends]])."},
        {"t": [4, 5, 6], "es": "a su hijo", "base": "son", "sense": "family"},
        {"t": [7], "es": "antes de que", "base": "before", "sense": "earlier-than"},
        {"t": [8], "es": "él"},
        {"t": [9], "es": "desapareció", "base": "disappear", "sense": "vanish"}
      ]
    },
    {
      "id": 30,
      "line": [
        {"t": [0, 1, 2, 3, 4], "es": "¿Cuándo la envió por correo?»"}
