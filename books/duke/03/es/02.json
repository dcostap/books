      "words": [
        {"t": [0], "es": "Holmes"},
        {"t": [1], "es": "entonces", "base": "then", "sense": "next"},
        {"t": [2], "es": "empezó", "base": "begin", "sense": "start"},
        {"t": [3, 4], "es": "de inmediato", "base": "at once", "sense": "immediately", "note": "No se traduce palabra por palabra: aquí *once* no significa «una vez»."},
