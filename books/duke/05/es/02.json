        {"t": [2], "es": "usted"},
        {"t": [4, 6], "es": "algunas huellas", "base": "track", "sense": "mark", "note": "En preguntas, *any* pregunta si hay alguna cantidad, sin precisar cuánta ([[some-any]])."},
        {"t": [5], "es": "de vaca", "base": "cow", "sense": "animal", "note": "En *cow tracks*, el primer sustantivo describe al segundo: huellas de vaca ([[noun-as-adjective]])."},
