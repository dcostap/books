      ],
      "words": [
        {"t": [0, 1, 2], "es": "no tan deprisa", "base": "not so fast", "sense": "wait", "note": "*Not so fast* también sirve para frenar una conclusión precipitada, no solo a alguien que corre."},
        {"t": [3], "es": "Watson"}
      ]
    },
    {
      "id": 101,
      "line": [{"t": [0, 1, 2], "es": "Piénselo."}],
      "words": [
