        {"t": [2, 3], "es": "no sé", "base": "know", "sense": "information", "note": "*Don’t* es *do not* ([[contractions]]). *Do not* forma la negación; *know* queda en forma base ([[auxiliary-do]])."},
        {"t": [4], "es": "yo"},
        {"t": [5], "es": "simplemente", "base": "just", "sense": "only"},
        {"t": [6, 7], "es": "no sé", "base": "know", "sense": "information", "note": "*Don’t* es *do not* ([[contractions]]). *Do not* forma la negación; *know* queda en forma base ([[auxiliary-do]])."}
      ]
