      "words": [
        {"t": [0, 2], "es": "unas huellas", "base": "track", "sense": "mark", "note": "*Some* indica una cantidad sin precisar ([[some-any]])."},
        {"t": [1], "es": "de vaca", "base": "cow", "sense": "animal", "note": "En *cow tracks*, el primer sustantivo describe al segundo: huellas de vaca ([[noun-as-adjective]])."},
