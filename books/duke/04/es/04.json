        {"t": [2], "es": "dije", "base": "say", "sense": "speak"},
        {"t": [3], "es": "porque"},
        {"t": [4, 5], "es": "el niño", "base": "boy", "sense": "child"},
        {"t": [6], "es": "tiene", "base": "have", "sense": "possess"},
        {"t": [7, 8], "es": "una bicicleta", "base": "bicycle", "sense": "vehicle"}
      ]
    },
    {
      "id": 100,
      "line": [
        {"t": [0, 1, 2], "es": "«No tan deprisa,"},
