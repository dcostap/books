        {"t": [9, 10, 11, 12, 13], "es": "a unos kilómetros a nuestra izquierda,"},
        {"t": [14, 15, 16, 17, 18], "es": "y delante de nosotros"},
        {"t": [19, 20, 21, 22, 23, 24], "es": "veíamos la carretera de Chesterfield."}
