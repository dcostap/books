        {"t": [2, 3], "es": "de personas", "base": "person", "sense": "human", "note": "*People* es el plural de *person*. Lleva verbo en plural, aunque «gente» sea singular ([[plural-agreement]])."},
        {"t": [4, 6], "es": "sin huellas", "base": "track", "sense": "mark", "note": "*No* delante de un sustantivo indica que no hay ninguno ([[negative-words]])."},
        {"t": [5], "es": "de bicicleta", "base": "bicycle", "sense": "vehicle", "note": "En *bicycle tracks*, el primer sustantivo describe al segundo: huellas de bicicleta ([[noun-as-adjective]])."}
      ]
    },
    {
      "id": 109,
      "line": [
        {"t": [0], "es": "«Holmes»,"},
