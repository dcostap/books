    {
      "id": 9,
      "line": [
        {"t": [0, 1, 2, 3], "es": "Dejó al duque"},
        {"t": [4, 5, 6, 7], "es": "hace unos tres meses,"},
        {"t": [8, 9], "es": "creo."}
      ],
      "words": [
        {"t": [0], "es": "ella"},
        {"t": [1], "es": "dejó, abandonó", "base": "leave", "sense": "abandon"},
        {"t": [2, 3], "es": "el duque", "base": "duke", "sense": "noble"},
        {"t": [4], "es": "aproximadamente", "base": "about", "sense": "approximately", "note": "Delante de una cantidad, *about* significa «aproximadamente»: no es «sobre» un tema."},
        {"t": [5], "es": "tres"},
        {"t": [6], "es": "meses", "base": "month", "sense": "time"},
        {"t": [7], "es": "hace", "base": "ago", "sense": "before", "note": "*Ago* va detrás de la cantidad de tiempo: *three months ago* = «hace tres meses»."},
        {"t": [8], "es": "yo"},
        {"t": [9], "es": "creo", "base": "think", "sense": "believe"}
      ]
    },
    {
      "id": 10,
      "line": [
        {"t": [0, 1, 2], "es": "Pero el niño"},
        {"t": [3, 4, 5], "es": "quería a su madre"},
        {"t": [6, 7, 8, 9], "es": "y estaba muy triste"},
        {"t": [10, 11, 12], "es": "cuando ella se fue."}
      ],
      "words": [
        {"t": [0], "es": "pero"},
        {"t": [1, 2], "es": "el niño", "base": "boy", "sense": "child"},
        {"t": [3], "es": "quería", "base": "love", "sense": "affection"},
        {"t": [4, 5], "es": "su madre", "base": "mother", "sense": "parent"},
        {"t": [6], "es": "y"},
        {"t": [7], "es": "estaba", "base": "be", "sense": "state"},
        {"t": [8], "es": "muy", "base": "very", "sense": "degree"},
        {"t": [9], "es": "triste", "base": "unhappy", "sense": "sad"},
        {"t": [10], "es": "cuando"},
        {"t": [11], "es": "ella"},
        {"t": [12], "es": "se fue", "base": "leave", "sense": "depart"}
      ]
