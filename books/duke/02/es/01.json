      "id": 0,
      "line": [
        {"t": [0, 1], "es": "Capítulo dos:"},
        {"t": [2, 3, 4], "es": "la historia del doctor Huxtable"}
      ],
      "words": [
        {"t": [0], "es": "capítulo", "base": "chapter", "sense": "book"},
        {"t": [1], "es": "dos"},
        {"t": [2], "es": "doctor", "note": "Abreviatura de *doctor*. En inglés británico suele ir sin punto; en EE. UU., *Dr.* ([[british-american]])."},
        {"t": [3], "es": "de Huxtable", "note": "El *’s* indica de quién es algo: *Dr Huxtable’s story* = «la historia del doctor Huxtable» ([[possessive-s]])."},
        {"t": [4], "es": "historia", "base": "story", "sense": "account"}
      ]
    },
    {
      "id": 1,
      "line": [
        {"t": [0, 1], "es": "«Mi colegio"},
        {"t": [2, 3, 4, 5, 6, 7, 8], "es": "—el colegio Priory, cerca de Mackleton—"},
        {"t": [9, 10, 11, 12, 13, 14, 15, 16, 17], "es": "es el mejor colegio de Inglaterra para niños pequeños»,"},
        {"t": [18, 19, 20], "es": "empezó el doctor Huxtable."}
      ],
      "words": [
        {"t": [0, 1], "es": "mi colegio", "base": "school", "sense": "education"},
        {"t": [3, 4, 5], "es": "el colegio Priory", "base": "school", "sense": "education"},
        {"t": [6, 7], "es": "cerca de Mackleton"},
        {"t": [9], "es": "es", "base": "be", "sense": "identity"},
        {"t": [10, 12], "es": "el colegio", "base": "school", "sense": "education"},
        {"t": [11], "es": "mejor", "base": "good", "sense": "quality", "note": "*The best* es el superlativo irregular de *good*: «el mejor» ([[comparatives]])."},
        {"t": [13, 15], "es": "para niños", "base": "boy", "sense": "child"},
        {"t": [14], "es": "pequeños, de poca edad", "base": "young", "sense": "age"},
        {"t": [16, 17], "es": "en Inglaterra"},
        {"t": [18], "es": "empezó", "base": "begin", "sense": "start"},
        {"t": [19], "es": "doctor", "note": "Abreviatura de *doctor*. En inglés británico suele ir sin punto; en EE. UU., *Dr.* ([[british-american]])."},
        {"t": [20], "es": "Huxtable"}
      ]
    },
    {
      "id": 2,
      "line": [
        {"t": [0, 1, 2, 3], "es": "«Tenemos a los hijos"},
        {"t": [4, 5, 6, 7, 8], "es": "de lord Soames, de lord Lever"},
        {"t": [9, 10, 11, 12, 13, 14], "es": "y de muchas otras personas importantes."}
      ],
      "words": [
        {"t": [0], "es": "nosotros"},
        {"t": [1], "es": "tenemos", "base": "have", "sense": "possess"},
        {"t": [2, 3], "es": "los hijos", "base": "son", "sense": "family"},
        {"t": [4, 5], "es": "de lord", "base": "lord", "sense": "noble", "note": "*Lord* es un título de la nobleza británica. Se usa delante del nombre."},
        {"t": [6], "es": "Soames"},
        {"t": [7], "es": "lord", "base": "lord", "sense": "noble", "note": "*Lord* es un título de la nobleza británica. Se usa delante del nombre."},
        {"t": [8], "es": "Lever"},
        {"t": [9], "es": "y"},
        {"t": [10, 14], "es": "de personas", "base": "person", "sense": "human"},
        {"t": [11], "es": "muchas", "base": "many", "sense": "number"},
        {"t": [12], "es": "otras", "base": "other", "sense": "different"},
        {"t": [13], "es": "importantes", "base": "important", "sense": "value"}
      ]
    },
    {
      "id": 3,
      "line": [
        {"t": [0, 1, 2], "es": "Hace tres semanas"},
        {"t": [3, 4, 5, 6, 7, 8, 9, 10], "es": "el señor James Wilder, secretario del duque de Holdernesse,"},
        {"t": [11, 12, 13, 14], "es": "vino a verme."}
      ],
      "words": [
        {"t": [0], "es": "tres"},
        {"t": [1], "es": "semanas", "base": "week", "sense": "time"},
        {"t": [2], "es": "hace", "base": "ago", "sense": "before", "note": "*Ago* va detrás de la cantidad de tiempo: *three weeks ago* = «hace tres semanas»."},
        {"t": [3], "es": "señor", "note": "*Mr* va delante del apellido o del nombre completo. En inglés británico suele ir sin punto; en EE. UU., *Mr.* ([[british-american]])."},
        {"t": [4, 5], "es": "James Wilder"},
        {"t": [6, 7, 8, 9], "es": "del duque de Holdernesse", "base": "duke", "sense": "noble", "note": "El *’s* indica posesión y se añade al final del nombre completo: *the Duke of Holdernesse’s secretary* ([[possessive-s]])."},
        {"t": [10], "es": "secretario", "base": "secretary", "sense": "assistant"},
        {"t": [11], "es": "vino", "base": "come", "sense": "move"},
        {"t": [12, 13], "es": "a ver", "base": "see", "sense": "visit"},
        {"t": [14], "es": "me, a mí"}
      ]
    },
    {
      "id": 4,
      "line": [
        {"t": [0, 1], "es": "El duque,"},
        {"t": [2, 3], "es": "según me dijo,"},
        {"t": [4, 5, 6, 7, 8], "es": "quería enviar a su hijo,"},
        {"t": [9, 10, 11, 12], "es": "lord Saltire, de diez años,"},
        {"t": [13, 14, 15], "es": "a mi colegio."}
      ],
      "words": [
        {"t": [0, 1], "es": "el duque", "base": "duke", "sense": "noble"},
        {"t": [2], "es": "él"},
        {"t": [3], "es": "dijo", "base": "say", "sense": "speak"},
        {"t": [4], "es": "quería", "base": "want", "sense": "desire"},
        {"t": [5, 6], "es": "enviar", "base": "send", "sense": "dispatch"},
        {"t": [7, 8], "es": "su hijo", "base": "son", "sense": "family"},
        {"t": [9, 11], "es": "el lord", "base": "lord", "sense": "noble", "note": "*Lord* es un título de la nobleza británica. Se usa delante del nombre."},
        {"t": [10], "es": "de diez años", "base": "old", "sense": "years", "note": "Delante de un nombre, la edad lleva guiones y *year* va en singular: *ten-year-old* ([[noun-as-adjective]])."},
        {"t": [12], "es": "Saltire"},
        {"t": [13, 14, 15], "es": "a mi colegio", "base": "school", "sense": "education"}
      ]
    },
    {
      "id": 5,
      "line": [
        {"t": [0, 1, 2, 3, 4], "es": "«El uno de mayo"},
        {"t": [5, 6, 7, 8], "es": "llegó el joven lord Saltire."}
      ],
      "words": [
        {"t": [0, 1, 2], "es": "el día uno", "note": "En las fechas inglesas se usan números ordinales: *1st* se lee *first* ([[ordinal-dates]])."},
        {"t": [3, 4], "es": "de mayo", "note": "En inglés, los meses se escriben con mayúscula: *May*."},
        {"t": [5], "es": "joven", "base": "young", "sense": "age"},
        {"t": [6], "es": "lord", "base": "lord", "sense": "noble", "note": "*Lord* es un título de la nobleza británica. Se usa delante del nombre."},
        {"t": [7], "es": "Saltire"},
        {"t": [8], "es": "llegó", "base": "arrive", "sense": "reach"}
      ]
    },
    {
      "id": 6,
      "line": [
        {"t": [0, 1, 2, 3], "es": "Es un niño simpático,"},
        {"t": [4, 5, 6, 7], "es": "y pronto empezó"},
        {"t": [8, 9, 10, 11], "es": "a disfrutar de la vida en el colegio"},
        {"t": [12, 13, 14, 15], "es": "y a hacer amigos."}
      ],
      "words": [
        {"t": [0], "es": "es", "base": "be", "sense": "identity", "note": "*He’s* es aquí *he is* ([[contractions]]). En otras frases, puede ser *he has*."},
        {"t": [1, 3], "es": "un niño", "base": "boy", "sense": "child"},
        {"t": [2], "es": "simpático", "base": "nice", "sense": "kind"},
        {"t": [4], "es": "y"},
        {"t": [5], "es": "él"},
        {"t": [6], "es": "pronto", "base": "soon", "sense": "time"},
        {"t": [7], "es": "empezó", "base": "begin", "sense": "start"},
        {"t": [8, 9], "es": "gustar", "base": "like", "sense": "enjoy", "note": "Aquí la frase dice «disfrutar de», pero *like* solo expresa que algo te gusta."},
        {"t": [10], "es": "del colegio", "base": "school", "sense": "education", "note": "*School* describe el tipo de vida: el sustantivo principal va al final, *life* ([[noun-as-adjective]])."},
        {"t": [11], "es": "vida", "base": "life", "sense": "existence"},
        {"t": [12], "es": "y"},
        {"t": [13, 14, 15], "es": "a hacer amigos", "base": "make friends", "sense": "friendship", "note": "La expresión es *make friends*, no *do friends*."}
      ]
    },
    {
      "id": 7,
      "line": [
        {"t": [0, 1, 2, 3], "es": "Su vida en casa,"},
        {"t": [4, 5], "es": "ya ve usted,"},
        {"t": [6, 7, 8, 9], "es": "no era muy feliz:"},
        {"t": [11, 12, 13, 14, 15, 16], "es": "todos sabemos lo del duque"},
        {"t": [17, 18, 19], "es": "y su esposa."}
      ],
      "words": [
        {"t": [0, 1], "es": "su vida", "base": "life", "sense": "existence"},
        {"t": [2, 3], "es": "en casa", "base": "home", "sense": "dwelling"},
        {"t": [4, 5], "es": "ya ve usted", "base": "you see", "sense": "explanation", "note": "*You see* introduce una explicación; no pide que mires nada."},
        {"t": [6, 7], "es": "no era", "base": "be", "sense": "identity"},
        {"t": [8], "es": "muy", "base": "very", "sense": "degree"},
        {"t": [9], "es": "feliz", "base": "happy", "sense": "feeling"},
        {"t": [11], "es": "nosotros"},
        {"t": [12], "es": "todos"},
        {"t": [13, 14], "es": "sabemos de", "base": "know", "sense": "information", "note": "*Know about* es tener información sobre algo, no conocer personalmente a alguien."},
        {"t": [15, 16], "es": "el duque", "base": "duke", "sense": "noble"},
        {"t": [17], "es": "y"},
        {"t": [18, 19], "es": "su esposa", "base": "wife", "sense": "spouse"}
      ]
    },
    {
      "id": 8,
      "line": [
        {"t": [0, 1], "es": "La duquesa,"},
        {"t": [2, 3], "es": "por supuesto,"},
        {"t": [4, 5], "es": "vive ahora"},
        {"t": [6, 7, 8, 9, 10], "es": "en el sur de Francia."}
      ],
      "words": [
        {"t": [0, 1], "es": "la duquesa", "base": "duchess", "sense": "title"},
        {"t": [2, 3], "es": "por supuesto", "base": "of course", "sense": "obvious", "note": "Es una expresión fija: no habla de un «curso»."},
        {"t": [4], "es": "ahora", "base": "now", "sense": "present"},
        {"t": [5], "es": "vive", "base": "live", "sense": "reside"},
        {"t": [6, 7, 8], "es": "en el sur", "base": "south", "sense": "direction"},
