        {"t": [0, 1], "es": "Perdimos"},
        {"t": [2, 3], "es": "tres días"},
        {"t": [4, 5, 6], "es": "por eso."}
      ],
      "words": [
        {"t": [0], "es": "nosotros"},
        {"t": [1], "es": "perdimos", "base": "lose", "sense": "loss"},
        {"t": [2], "es": "tres"},
