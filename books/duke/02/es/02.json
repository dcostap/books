        {"t": [13, 14], "es": "a Londres"},
        {"t": [15, 16], "es": "esta mañana", "base": "morning", "sense": "time"}
      ]
    },
    {
      "id": 49,
      "line": [
        {"t": [0, 1, 2], "es": "«Bien, doctor Huxtable,"},
        {"t": [3, 4, 5], "es": "unas preguntas más»,"},
        {"t": [6, 7], "es": "dijo Holmes."}
      ],
      "words": [
        {"t": [0], "es": "bueno, bien", "base": "well", "sense": "discourse"},
        {"t": [1], "es": "doctor", "note": "Abreviatura de *doctor*. En inglés británico suele ir sin punto; en EE. UU., *Dr.* ([[british-american]])."},
