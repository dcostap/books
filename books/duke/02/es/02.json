        {"t": [13], "es": "pero"},
        {"t": [14], "es": "eso"},
        {"t": [15], "es": "era", "base": "be", "sense": "identity", "note": "Aquí *it was* sirve para identificar a las personas que encontraron, aunque haya más de una."},
        {"t": [16, 17], "es": "un hombre", "base": "man", "sense": "adult"},
        {"t": [18], "es": "y"},
        {"t": [19, 20], "es": "su hijo", "base": "son", "sense": "family"},
        {"t": [21], "es": "yendo", "base": "go", "sense": "move"},
        {"t": [22, 23], "es": "a visitar", "base": "visit", "sense": "go", "note": "*To* con infinitivo indica para qué iban: a visitar a alguien ([[purpose-infinitive]])."},
        {"t": [24, 25], "es": "un amigo", "base": "friend", "sense": "person"}
