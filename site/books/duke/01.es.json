:[{"t":[0,1],"es":"Holmes buscó"},{"t":[2,3,4,5],"es":"en los bolsillos del hombre"},{"t":[7,8],"es":"y encontró"},{"t":[9,10,11],"es":"un billete de tren"},{"t":[12,13],"es":"de Mackleton,"},{"t":[14,15,16,17,18],"es":"en el norte de Inglaterra."}],"units":[{"t":[0],"es":"Holmes"},{"t":[1],"es":"miró","base":"look","sense":"see","note":"*Look in* es «mirar dentro de». Aquí, «buscó» suena más natural en español."},{"t":[2,5],"es":"en los bolsillos","base":"pocket","sense":"clothing"},{"t":[3,4],"es":"del hombre","base":"man","sense":"adult","note":"El *’s* indica de quién es algo: *the man’s pockets* = «los bolsillos del hombre» ([[possessive-s]])."},{"t":[7],"es":"y"},{"t":[8],"es":"encontró","base":"find","sense":"discover"},{"t":[9,11],"es":"un billete","base":"ticket","sense":"travel"},{"t":[10],"es":"de tren","base":"train","sense":"transport","note":"Un sustantivo puede describir a otro: *train* dice de qué es el billete. Lo principal va al final ([[noun-as-adjective]])."},{"t":[12,13],"es":"de Mackleton"},{"t":[14,15,16],"es":"en el norte","base":"north","sense":"direction"},{"t":[17,18],"es":"de Inglaterra"}]},null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null]