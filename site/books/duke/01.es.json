[{"es":"Capítulo uno: Sherlock Holmes recibe una visita","line":[{"t":[0,1],"es":"Capítulo uno:"},{"t":[2,3],"es":"Sherlock Holmes"},{"t":[4,5,6],"es":"recibe una visita"}],"units":[{"t":[0],"es":"capítulo","base":"chapter","sense":"book"},{"t":[1],"es":"uno"},{"t":[2,3],"es":"Sherlock Holmes"},{"t":[4],"es":"tiene, recibe","base":"have","sense":"possess"},{"t":[5,6],"es":"una visita, un visitante","base":"visitor","sense":"guest"}]},{"es":"Cuando venían visitas a ver a Sherlock Holmes en Baker Street, a menudo hacían cosas sorprendentes.","line":[{"t":[0,1,2],"es":"Cuando venían visitas"},{"t":[3,4,5,6],"es":"a ver a Sherlock Holmes"},{"t":[7,8,9],"es":"en Baker Street,"},{"t":[10,11,12],"es":"a menudo hacían"},{"t":[13,14],"es":"cosas sorprendentes."}],"units":[{"t":[0],"es":"cuando"},{"t":[1],"es":"visitas, visitantes","base":"visitor","sense":"guest"},{"t":[2],"es":"venían","base":"come","sense":"move"},{"t":[3,4],"es":"a ver","base":"see","sense":"visit"},{"t":[5,6],"es":"Sherlock Holmes"},{"t":[7,8,9],"es":"en Baker Street","base":"street","sense":"road","note":"*Street* significa «calle». En inglés, va detrás del nombre: *Baker Street*."},{"t":[10],"es":"ellos, ellas"},{"t":[11],"es":"a menudo","base":"often","sense":"frequency"},{"t":[12],"es":"hacían","base":"do","sense":"perform"},{"t":[13],"es":"sorprendentes","base":"surprising","sense":"unexpected"},{"t":[14],"es":"cosas","base":"thing","sense":"object"}]},{"es":"A veces hundían la cabeza entre las manos y lloraban.","line":[{"t":[0],"es":"A veces"},{"t":[1,2,3,4],"es":"hundían la cabeza"},{"t":[5,6,7],"es":"entre las manos"},{"t":[8,9],"es":"y lloraban."}],"units":[{"t":[0],"es":"a veces","base":"sometimes","sense":"frequency"},{"t":[1],"es":"ellos, ellas"},{"t":[2],"es":"ponían","base":"put","sense":"place","note":"Aquí, «hundían» suena más natural en español: el gesto de poner la cabeza entre las manos."},{"t":[3,4],"es":"sus cabezas","base":"head","sense":"body","note":"En inglés, las partes del cuerpo llevan posesivo: *their heads*, *his eyes* ([[body-possessive]])."},{"t":[5,6,7],"es":"en sus manos","base":"hand","sense":"body"},{"t":[8],"es":"y"},{"t":[9],"es":"lloraban","base":"cry","sense":"weep"}]},{"es":"A veces hablaban y hablaban, y no podían parar.","line":[{"t":[0],"es":"A veces"},{"t":[1,2,3,4],"es":"hablaban y hablaban,"},{"t":[5,6,7],"es":"y no podían parar."}],"units":[{"t":[0],"es":"a veces","base":"sometimes","sense":"frequency"},{"t":[1],"es":"ellos, ellas"},{"t":[2],"es":"hablaban","base":"talk","sense":"speak"},{"t":[3],"es":"y"},{"t":[4],"es":"hablaban","base":"talk","sense":"speak"},{"t":[5],"es":"y"},{"t":[6,7],"es":"no podían parar","base":"stop","sense":"halt","note":"*Couldn’t* es *could not*: «no podían». Es una forma abreviada, muy habitual al hablar ([[contractions]])."}]},{"es":"Y a veces se quedaban allí sentados sin decir palabra.","line":[{"t":[0,1],"es":"Y a veces"},{"t":[2,3,4,5],"es":"se quedaban allí sentados"},{"t":[6,7,8,9,10],"es":"sin decir palabra."}],"units":[{"t":[0],"es":"y"},{"t":[1],"es":"a veces","base":"sometimes","sense":"frequency"},{"t":[2],"es":"ellos, ellas"},{"t":[3],"es":"simplemente, solo","base":"just","sense":"only"},{"t":[4],"es":"estaban sentados","base":"sit","sense":"seated"},{"t":[5],"es":"allí","base":"there","sense":"place"},{"t":[6],"es":"y"},{"t":[7,8],"es":"no decían","base":"say","sense":"speak","note":"*Did* ayuda a formar la negación en pasado; *say* queda en su forma base ([[auxiliary-do]])."},{"t":[9,10],"es":"una palabra","base":"word","sense":"language"}]},{"es":"Pero nadie era más sorprendente que el doctor Thorneycroft Huxtable.","line":[{"t":[0,1,2],"es":"Pero nadie era"},{"t":[3,4],"es":"más sorprendente"},{"t":[5,6,7,8],"es":"que el doctor Thorneycroft Huxtable."}],"units":[{"t":[0],"es":"pero"},{"t":[1],"es":"nadie"},{"t":[2],"es":"era","base":"be","sense":"identity"},{"t":[3],"es":"más"},{"t":[4],"es":"sorprendente","base":"surprising","sense":"unexpected"},{"t":[5],"es":"que"},