[{"es":"Capítulo uno: Sherlock Holmes recibe una visita","line":[{"t":[0,1],"es":"Capítulo uno:"},{"t":[2,3],"es":"Sherlock Holmes"},{"t":[4,5,6],"es":"recibe una visita"}],"units":[{"t":[0],"es":"capítulo"},{"t":[1],"es":"uno"},{"t":[2,3],"es":"Sherlock Holmes"},{"t":[4],"es":"tiene, recibe","also":["haber, como auxiliar (*has finished*)","tomar (*have breakfast*)"]},{"t":[5,6],"es":"una visita, un visitante"}]},{"es":"Cuando venían visitas a ver a Sherlock Holmes en Baker Street, a menudo hacían cosas sorprendentes.","line":[{"t":[0,1,2],"es":"Cuando venían visitas"},{"t":[3,4,5,6],"es":"a ver a Sherlock Holmes"},{"t":[7,8,9],"es":"en Baker Street,"},{"t":[10,11,12],"es":"a menudo hacían"},{"t":[13,14],"es":"cosas sorprendentes."}],"units":[{"t":[0],"es":"cuando"},{"t":[1],"es":"visitas, visitantes"},{"t":[2],"es":"venían","base":"come","forms":{"past":"came","participle":"come"},"also":["llegar (*the day came*)","ser de, venir de (*I come from Spain*)"]},{"t":[3,4],"es":"a ver","also":["entender (*I see what you mean*)"]},{"t":[5,6],"es":"Sherlock Holmes"},{"t":[7,8,9],"es":"en Baker Street","note":"*Street* significa «calle». En inglés, va detrás del nombre: *Baker Street*."},{"t":[10],"es":"ellos, ellas"},{"t":[11],"es":"a menudo"},{"t":[12],"es":"hacían"},{"t":[13],"es":"sorprendentes"},{"t":[14],"es":"cosas"}]},{"es":"A veces hundían la cabeza entre las manos y lloraban.","line":[{"t":[0],"es":"A veces"},{"t":[1,2,3,4],"es":"hundían la cabeza"},{"t":[5,6,7],"es":"entre las manos"},{"t":[8,9],"es":"y lloraban."}],"units":[{"t":[0],"es":"a veces"},{"t":[1],"es":"ellos, ellas"},{"t":[2],"es":"ponían","base":"put","forms":{"past":"put","participle":"put"},"note":"Aquí, «hundían» suena más natural en español: el gesto de poner la cabeza entre las manos."},{"t":[3,4],"es":"sus cabezas","also":["jefe (*head of the school*)"],"note":"Con partes del cuerpo, el español usa «la» y no «su», y el singular si cada uno tiene una: «hundían la cabeza»."},{"t":[5,6,7],"es":"en sus manos","note":"Como antes: en español, «entre las manos»."},{"t":[8],"es":"y"},{"t":[9],"es":"lloraban","also":["gritar (*cry for help*)"]}]},{"es":"A veces hablaban y hablaban, y no podían parar.","line":[{"t":[0],"es":"A veces"},{"t":[1,2,3,4],"es":"hablaban y hablaban,"},{"t":[5,6,7],"es":"y no podían parar."}],"units":[{"t":[0],"es":"a veces"},{"t":[1],"es":"ellos, ellas"},{"t":[2],"es":"hablaban"},{"t":[3],"es":"y"},{"t":[4],"es":"hablaban","note":"Repetir el verbo con *and* indica que la acción sigue mucho tiempo: «hablaban sin parar»."},{"t":[5],"es":"y"},{"t":[6,7],"es":"no podían parar","note":"*Couldn’t* es *could not*: «no podían». Es una forma abreviada, muy habitual al hablar ([[contractions]])."}]},{"es":"Y a veces se quedaban allí sentados sin decir palabra.","line":[{"t":[0,1],"es":"Y a veces"},{"t":[2,3,4,5],"es":"se quedaban allí sentados"},{"t":[6,7,8,9,10],"es":"sin decir palabra."}],"units":[{"t":[0],"es":"y"},{"t":[1],"es":"a veces"},{"t":[2],"es":"ellos, ellas"},{"t":[3],"es":"simplemente, solo","also":["acabar de (*I’ve just arrived*)","justo, exactamente (*just here*)"]},{"t":[4],"es":"estaban sentados","base":"sit","forms":{"past":"sat","participle":"sat"}},{"t":[5],"es":"allí"},{"t":[6],"es":"y"},{"t":[7,8],"es":"no decían","note":"*Did* ayuda a formar la negación en pasado; *say* queda en su forma base ([[auxiliary-do]])."},{"t":[9,10],"es":"una palabra"}]},{"es":"Pero nadie era más sorprendente que el doctor Thorneycroft Huxtable.","line":[{"t":[0,1,2],"es":"Pero nadie era"},{"t":[3,4],"es":"más sorprendente"},{"t":[5,6,7,8],"es":"que el doctor Thorneycroft Huxtable."}],"units":[{"t":[0],"es":"pero"},{"t":[1],"es":"nadie"},{"t":[2],"es":"era"},{"t":[3],"es":"más","note":"El comparativo *more … than* equivale a «más… que» ([[comparatives]])."},{"t":[4],"es":"sorprendente"},{"t":[5],"es":"que"},{"t":[6],"es":"doctor","note":"Abreviatura de *doctor*. En inglés británico suele ir sin punto; en EE. UU., *Dr.* ([[british-american]])."},{"t":[7,8],"es":"Thorneycroft Huxtable"}]},{"es":"Era un hombre corpulento, alto, bien vestido y con aire de importancia.","line":[{"t":[0,1],"es":"Era"},{"t":[2,3,4],"es":"un hombre corpulento,"},{"t":[5],"es":"alto,"},{"t":[6],"es":"bien vestido"},{"t":[7,8],"es":"y con aire de importancia."}],"units":[{"t":[0],"es":"él"},{"t":[1],"es":"era"},{"t":[2,4],"es":"un hombre"},{"t":[3],"es":"corpulento, grandote"},{"t":[5],"es":"alto"},{"t":[6],"es":"bien vestido"},{"t":[7],"es":"y"},{"t":[8],"es":"con aire de importancia","note":"En palabras como esta, *-looking* habla del aspecto: parece importante, aunque no sabemos si lo es."}]},{"es":"Entró en la habitación, se acercó a uno de los grandes sillones y de pronto se desplomó en él.","line":[{"t":[0,1],"es":"Entró"},{"t":[2,3,4],"es":"en la habitación,"},{"t":[5,6,7],"es":"se acercó a uno"},{"t":[8,9,10,11],"es":"de los grandes sillones"},{"t":[12,13],"es":"y de pronto"},{"t":[14,15,16],"es":"se desplomó en él."}],"units":[{"t":[0],"es":"él"},{"t":[1],"es":"vino, entró","base":"come","forms":{"past":"came","participle":"come"}},{"t":[2,3,4],"es":"en la habitación","also":["espacio (*room for two*)"]},{"t":[5],"es":"caminó, fue andando","note":"Aquí, «se acercó» suena más natural en español."},{"t":[6,7],"es":"a uno"},{"t":[8,9,11],"es":"de los sillones"},{"t":[10],"es":"grandes"},{"t":[12],"es":"y"},{"t":[13],"es":"de pronto"},{"t":[14],"es":"cayó, se dejó caer","base":"fall","forms":{"past":"fell","participle":"fallen"},"also":["bajar (*prices fall*)"],"note":"Aquí, «se desplomó» suena más natural en español."},{"t":[15,16],"es":"en él"}]},{"es":"Estaba sentado allí, con los ojos cerrados; parecía pálido y enfermo.","line":[{"t":[0,1,2],"es":"Estaba sentado allí,"},{"t":[3,4,5,6],"es":"con los ojos cerrados;"},{"t":[7,8,9,10],"es":"parecía pálido y enfermo."}],"units":[{"t":[0],"es":"él"},{"t":[1],"es":"estaba sentado","base":"sit","forms":{"past":"sat","participle":"sat"}},{"t":[2],"es":"allí"},{"t":[3,4,5],"es":"con sus ojos","note":"Como con *their heads*: en español, «con los ojos»."},{"t":[6],"es":"cerrados"},{"t":[7],"es":"con aspecto de, pareciendo","also":["mirar (*look at me*)"]},{"t":[8],"es":"pálido","also":["blanco (*a white shirt*)"]},{"t":[9],"es":"y"},{"t":[10],"es":"enfermo","note":"*Ill* es lo habitual en inglés británico; en EE. UU. se suele decir *sick* ([[british-american]])."}]},{"es":"Corrí a buscarle un poco de agua.","line":[{"t":[0,1],"es":"Corrí"},{"t":[2,3,4,5,6,7],"es":"a buscarle un poco de agua."}],"units":[{"t":[0],"es":"yo"},{"t":[1],"es":"corrí","base":"run","forms":{"past":"ran","participle":"run"},"also":["funcionar (*the engine is running*)","dirigir (*run a shop*)"]},{"t":[2,3],"es":"a buscar","also":["conseguir (*get a job*)","llegar (*get home*)","ponerse (*get angry*)"]},{"t":[4,5],"es":"un poco de agua","note":"Con algo que no se cuenta ([[uncountable]]), *some* indica una cantidad sin precisar ([[some-any]])."},{"t":[6,7],"es":"para él"}]},{"es":"Luego cogí mi maletín de médico y lo examiné con atención.","line":[{"t":[0],"es":"Luego"},{"t":[1,2,3,4,5],"es":"cogí mi maletín de médico"},{"t":[6,7,8,9],"es":"y lo examiné"},{"t":[10],"es":"con atención."}],"units":[{"t":[0],"es":"luego, después","also":["entonces, en aquel momento (*I was young then*)"]},{"t":[1],"es":"yo"},{"t":[2],"es":"cogí","base":"get","forms":{"past":"got","participle":"got"}},{"t":[3,5],"es":"mi maletín"},{"t":[4],"es":"de médico","note":"El apóstrofo con *s* relaciona el maletín con el médico. Aquí indica el tipo de maletín ([[possessive-s]])."},{"t":[6],"es":"y"},{"t":[7,8],"es":"examiné, miré","base":"look at","note":"Para mirar a alguien o algo, se usa *look at*. No quites *at*: *look at him*."},{"t":[9],"es":"lo, a él"},{"t":[10],"es":"con atención"}]},{"es":"«¿Qué le pasa, Watson?», dijo Holmes.","line":[{"t":[0,1,2],"es":"«¿Qué le pasa,"},{"t":[3],"es":"Watson?»,"},{"t":[4,5],"es":"dijo Holmes."}],"units":[{"t":[0,1,2],"es":"¿qué le pasa?","note":"Esta pregunta sirve para preguntar qué ocurre, no solo para identificar una cosa."},{"t":[3],"es":"Watson"},{"t":[4],"es":"dijo","base":"say","forms":{"past":"said","participle":"said"}},{"t":[5],"es":"Holmes"}]},{"es":"«Está bien, creo», dije.","line":[{"t":[0,1,2],"es":"«Está bien,"},{"t":[3,4],"es":"creo»,"},{"t":[5,6],"es":"dije."}],"units":[{"t":[0],"es":"está","note":"*He’s* es aquí *he is*. Ojo: en otras frases, *he’s* puede ser *he has*."},{"t":[1,2],"es":"bien","base":"all right","note":"*All right* no tiene que ver con «derecha»: es una expresión para hablar de salud o dar tu aprobación.","also":["vale, de acuerdo (*all right, let’s go*)"]},{"t":[3],"es":"yo"},{"t":[4],"es":"creo"},{"t":[5],"es":"yo"},{"t":[6],"es":"dije","base":"say","forms":{"past":"said","participle":"said"}}]},{"es":"«Solo está agotado y probablemente también tiene hambre».","line":[{"t":[0,1,2,3,4],"es":"«Solo está agotado"},{"t":[6,7,8,9],"es":"y probablemente también tiene hambre»."}],"units":[{"t":[0],"es":"está"},{"t":[1],"es":"solo"},{"t":[2],"es":"muy"},{"t":[3],"es":"muy"},{"t":[4],"es":"cansado"},{"t":[6],"es":"y"},{"t":[7],"es":"probablemente"},{"t":[8],"es":"hambriento, con hambre"},{"t":[9],"es":"también","also":["demasiado (*too cold*)"]}]},{"es":"Holmes buscó en los bolsillos del hombre y encontró un billete de tren de Mackleton, en el norte de Inglaterra.","line":[{"t":[0,1],"es":"Holmes buscó"},{"t":[2,3,4,5],"es":"en los bolsillos del hombre"},{"t":[7,8],"es":"y encontró"},{"t":[9,10,11],"es":"un billete de tren"},{"t":[12,13],"es":"de Mackleton,"},{"t":[14,15,16,17,18],"es":"en el norte de Inglaterra."}],"units":[{"t":[0],"es":"Holmes"},{"t":[1],"es":"miró","note":"*Look in* es «mirar dentro de». Aquí, «buscó» suena más natural en español."},{"t":[2,5],"es":"en los bolsillos"},{"t":[3,4],"es":"del hombre"},{"t":[7],"es":"y"},{"t":[8],"es":"encontró","base":"find","forms":{"past":"found","participle":"found"},"also":["parecer, considerar (*I find it difficult*)"]},{"t":[9,11],"es":"u